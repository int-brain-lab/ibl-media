{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "id", "title", "credit", "reuse", "versions"],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-zA-Z0-9][a-zA-Z0-9_-]{0,99}$"},
    "title": {"$ref": "#/$defs/text"},
    "credit": {"$ref": "#/$defs/text"},
    "reuse": {"$ref": "#/$defs/text"},
    "versions": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["version", "upload_id", "uploaded_at", "uploaded_by", "credit", "reuse", "files"],
        "properties": {
          "version": {"type": "integer", "minimum": 1},
          "upload_id": {"$ref": "#/$defs/text"},
          "uploaded_at": {"type": "string", "format": "date-time"},
          "uploaded_by": {
            "type": "object", "additionalProperties": false, "required": ["github"],
            "properties": {"github": {"$ref": "#/$defs/text"}}
          },
          "credit": {"$ref": "#/$defs/text"},
          "reuse": {"$ref": "#/$defs/text"},
          "description": {"type": "string"},
          "dataset": {"type": "string"},
          "source": {
            "type": "object", "additionalProperties": false, "required": ["path", "sha256"],
            "properties": {
              "path": {"$ref": "#/$defs/text"},
              "sha256": {"$ref": "#/$defs/checksum"},
              "repository": {"$ref": "#/$defs/text"},
              "commit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
              "working_tree_dirty": {"type": "boolean"}
            }
          },
          "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}
        }
      }
    }
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "checksum": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "file": {
      "type": "object", "additionalProperties": false,
      "required": ["filename", "mime_type", "size_bytes", "sha256", "storage"],
      "properties": {
        "filename": {"$ref": "#/$defs/text"},
        "mime_type": {"$ref": "#/$defs/text"},
        "size_bytes": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/checksum"},
        "width_px": {"type": "integer", "minimum": 1},
        "height_px": {"type": "integer", "minimum": 1},
        "duration_seconds": {"type": "number", "minimum": 0},
        "storage": {
          "type": "object", "additionalProperties": false,
          "required": ["provider", "file_id", "url"],
          "properties": {
            "provider": {"const": "google-drive"},
            "file_id": {"$ref": "#/$defs/text"},
            "url": {"type": "string", "pattern": "^https://drive\\.google\\.com/"}
          }
        }
      }
    }
  }
}
